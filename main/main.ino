void setup() {
  // put your setup code here, to run once:

  // serial code 
  Serial.begin(115200);
  while(!Serial);   /* Waits for serial port to connect */


  memset(c, 0, sizeof(*c));

  memcpy(c->memory[0], chip8_fontset, sizeof(chip8_fontset));  /* Loads fonts to sram */
  for(int i = 0; i < sizeof(ibm_ch8); i++){                    /* Loads game ROM to sram */
    c->memory[0x200 + i] = pgm_read_byte_near(ibm_ch8[i]);
  }

  c->pc = 0x200;    /* Start of game */
  bool is_running = 1;
}

void loop() {
  // put your main code here, to run repeatedly:

  if(!is_running)
    return;
  
  emulate_cycle();  
}

void emulate_cycle(){
  uint16_t opcode = (c->memory[c->pc] << 8) | c->memory[c->pc + 1];
  
  if (c->pc >= 1000)
    is_running = 0;

  c->pc += 2;
}
